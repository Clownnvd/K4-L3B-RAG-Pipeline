# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_API_URL=https://api.pageindex.ai
PAGEINDEX_REQUEST_TIMEOUT_SECONDS=30
PAGEINDEX_POLL_TIMEOUT_SECONDS=60
PAGEINDEX_POLL_INTERVAL_SECONDS=2
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.30
